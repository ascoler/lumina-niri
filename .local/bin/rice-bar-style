#!/usr/bin/env bash
set -euo pipefail

STYLE="${1:-}"
CACHE_DIR="$HOME/.cache/theme"
mkdir -p "$CACHE_DIR"

if [ -z "$STYLE" ]; then
    qs ipc -c lumina call shell toggleBarStyle >/dev/null 2>&1 || true
    exit 0
fi

if [ "$STYLE" = "next" ] || [ "$STYLE" = "cycle" ]; then
    qs ipc -c lumina call shell cycleBarStyle >/dev/null 2>&1 || true
    exit 0
fi

case "$STYLE" in
    aurora|notch|cyber|eclipse|minimal)
        if qs ipc -c lumina call shell setBarStyle "$STYLE" >/dev/null 2>&1; then
            exit 0
        fi
        printf "%s\n" "$STYLE" > "$CACHE_DIR/bar_style"
        ;;
    *)
        echo "Usage: rice-bar-style [aurora|notch|cyber|eclipse|minimal|next]" >&2
        exit 1
        ;;
esac
