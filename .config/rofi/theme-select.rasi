@import "colors.rasi"

configuration {
    show-icons:                 false;
    font:                       "Modula 13";
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      480px;

    padding:                    20px;
    border:                     2px solid;
    border-radius:              16px;
    border-color:               @border-col;
    background-color:           @bg;
    cursor:                     "default";
}

mainbox {
    spacing:                    14px;
    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    spacing:                    10px;
    padding:                    10px 14px;
    border-radius:              10px;
    background-color:           @bg-alt;
    text-color:                 @fg;
    children:                   [ "prompt" ];
}

prompt {
    background-color:           transparent;
    text-color:                 @accent;
    font:                       "JetBrainsMono Nerd Font Bold 11";
}

listview {
    columns:                    1;
    lines:                      5;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    spacing:                    8px;
    background-color:           transparent;
    cursor:                     "default";
}

element {
    spacing:                    10px;
    padding:                    12px 14px;
    border-radius:              10px;
    background-color:           @bg-alt;
    text-color:                 @fg;
    cursor:                     pointer;
}

element normal.normal {
    background-color:           @bg-alt;
    text-color:                 @fg;
}

element selected.normal {
    background-color:           @accent;
    text-color:                 @bg;
    font:                       "JetBrainsMono Nerd Font Bold 11";
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
}
